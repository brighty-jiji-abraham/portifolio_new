{
  "description": "Cache the public portfolio homepage using the origin TTL",
  "expression": "(http.host eq \"brighty.pro\" and http.request.uri.path in {\"/\" \"/index.html\"})",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": { "mode": "bypass_by_default" },
    "browser_ttl": { "mode": "respect_origin" }
  },
  "enabled": true
}
